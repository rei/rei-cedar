{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "*.d.ts",
    "vite.config.ts",
    "vite.umd.config.ts",
    "vite.pages.config.mts",
    "build/**/*.ts",
    "build/**/*.mts",
    "build/**/*.mjs"
  ]
}
