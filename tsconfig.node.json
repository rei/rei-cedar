{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "vite.umd.config.ts",
    "vite.pages.config.mts",
    "vite-plugin-css-name-normalizer.ts",
    "build/*.ts",
    "lint-report-generator.ts",
    "docgen.ts",
    "docgen-scss.ts"
  ]
}
